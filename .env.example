# MongoDB connection string
# Example: mongodb://localhost:27017/funded
# Or MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/funded
MONGODB_URI=

# Application environment (development | production | test)
NODE_ENV=development

# Canonical public URL of the application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth.js / NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET=

# Canonical auth URL (used for callbacks and cookies)
AUTH_URL=http://localhost:3000

# Bootstrap admin credentials (used only by: npm run seed:admin)
# Do not commit real credentials. Never expose these in the client.
ADMIN_NAME=FundIt Admin
ADMIN_EMAIL=admin@funded.local
ADMIN_PASSWORD=

# Development demo investors (used only by: npm run seed:investors)
# Fictional accounts for local manual testing — never use in production.
# DEMO_INVESTOR_PASSWORD=FundIt@Demo123
# Set ALLOW_DEMO_SEED=true to run demo seeds manually in production (not recommended).

# Payment provider (Phase 4)
# Use "mock" for local development only. Production gateway selection is pending.
PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=INR
# Shared secret for signing mock payment webhooks (development)
MOCK_PAYMENT_WEBHOOK_SECRET=dev-mock-webhook-secret

# Cloudinary (server-side only — never expose API secret to the client)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
